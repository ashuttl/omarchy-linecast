{
  "schemaVersion": 1,
  "id": "ashuttl.linecast",
  "name": "Linecast",
  "version": "0.8.0",
  "author": "Andrew Shuttleworth",
  "license": "MIT",
  "description": "Weather, sun, moon, and tide pills from linecast, each opening a panel drawn in the theme",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Linecast",
    "description": "Weather, sunshine, moon, and tide pills with anchored panels; pick which pills show from the weather panel",
    "category": "Weather",
    "allowMultiple": false,
    "schema": [
      {
        "key": "pills",
        "type": "multiselect",
        "label": "Pills",
        "description": "Which pills this widget shows, in order. The first is always visible and the rest slide out on hover. Leave empty to show all four.",
        "noSelectionText": "All pills",
        "placeholderText": "Search pills...",
        "emptyText": "No pills",
        "options": [
          {
            "value": "weather",
            "label": "Weather",
            "description": "Conditions and temperature"
          },
          {
            "value": "sunshine",
            "label": "Sunshine",
            "description": "Solar arc and day length"
          },
          {
            "value": "moon",
            "label": "Moon",
            "description": "Phase and illumination"
          },
          {
            "value": "tides",
            "label": "Tides",
            "description": "Next high or low water"
          }
        ]
      },
      {
        "key": "alwaysShow",
        "type": "boolean",
        "label": "Always Show",
        "description": "Keep every pill out instead of sliding the extras in on hover.",
        "defaultValue": false
      },
      {
        "key": "clock",
        "type": "select",
        "label": "Clock",
        "description": "24-hour or 12-hour times in the panels and pills.",
        "defaultValue": "24h",
        "options": [
          {
            "value": "24h",
            "label": "24-hour"
          },
          {
            "value": "12h",
            "label": "12-hour"
          }
        ]
      }
    ]
  }
}
